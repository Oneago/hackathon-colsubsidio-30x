# ─────────────────────────────────────────────────────────────
# Configuración base del stack. Copia este archivo a `.env`:
#     cp .env.example .env
# `.env` está en .gitignore: NUNCA subas credenciales reales.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=inventario
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── API (FastAPI) ────────────────────────────────────────────
# La API escucha en 0.0.0.0 para ser alcanzable desde el móvil (emulador/LAN).
API_HOST=0.0.0.0
API_PORT=8000
# Puerto expuesto en el host (dev). El móvil físico usa la IP LAN del anfitrión.
API_PUBLISHED_PORT=8000

# Orígenes permitidos por CORS, separados por coma. "*" solo para desarrollo.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Seguridad / JWT (se usa a partir de la Fase 1) ───────────
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Usuario administrador inicial (creado por el seed, Fase 1).
ADMIN_CEDULA=1000000000
ADMIN_PASSWORD=admin_cambia_esta_clave
ADMIN_NOMBRE=Administrador

# Plantilla de demostración: 3 supervisores (cédulas 2000000001-3) y 6
# supernumerarios (3000000001-6), sembrados por el seed con esta misma clave.
# Ponlo en false para que un despliegue no cree usuarios con clave conocida.
SEED_USUARIOS_DEMO=true
DEMO_PASSWORD=demo1234

# ── Reglas de negocio ────────────────────────────────────────
# Umbral (%) a partir del cual una diferencia ERP vs. conteo se marca "crítica".
DIFF_UMBRAL_PCT=10

# ── ElevenLabs (TTS + STT, se usa a partir de la Fase 1) ─────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Modelo de Speech-to-Text para el dictado de cantidad desde el móvil.
ELEVENLABS_STT_MODEL_ID=scribe_v1
# Directorio (dentro del contenedor) donde se guardan los .mp3 pre-generados.
AUDIO_DIR=/audio_store

# ── Web (Vite) ───────────────────────────────────────────────
WEB_PUBLISHED_PORT=5173
